# 조회와 미리보기에는 인증 정보가 필요하지 않습니다.
# 실제 게시에 사용합니다. 비밀값은 .env 또는 GitHub Secrets에만 입력하세요.
IG_ACCESS_TOKEN=
IG_USER_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=stories
# 새 Supabase Secret key 사용 시 아래 값을 설정하면 service_role보다 우선합니다.
# SUPABASE_SECRET_KEY=

# Story 음식 일러스트 (없거나 실패하면 기본 Story로 게시)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# generate: 새 생성 허용 / cache: 저장된 결과만 / off: 장식 없음
# 기본값: 실제 게시 generate, 미리보기 cache
# STORY_ART_MODE=cache
