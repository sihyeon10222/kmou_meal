{
  "name": "kmou_meal",
  "version": "1.0.0",
  "description": "국립한국해양대학교 네 식당의 식단을 Instagram Story와 주간 피드로 만드는 자동화 서비스",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "tsx src/backend/cli/main.ts story",
    "story": "tsx src/backend/cli/main.ts story",
    "feed": "tsx src/backend/cli/main.ts feed",
    "preview": "tsx src/backend/cli/main.ts story --preview",
    "check-setup": "tsx src/backend/cli/check-setup.ts",
    "secrets:sync": "tsx scripts/ops/sync-secrets.ts",
    "build": "node scripts/ops/build.mjs",
    "typecheck": "tsc --project tsconfig.check.json && tsc --project tsconfig.frontend.json",
    "lint": "eslint src scripts tests fixtures --max-warnings=0",
    "benchmark": "tsx scripts/benchmark.ts",
    "fetch-menu": "tsx src/backend/cli/fetch-menu.ts",
    "test": "tsx --test tests/backend/*.test.ts tests/frontend/*.test.ts tests/shared/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "private": true
}
